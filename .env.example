# ===== 印刷包装 AI 自动混剪工作台 - 环境变量示例 =====
# 复制本文件为 .env 后按需修改（.env 不会被提交）

# 服务端口
PORT=3000

# FFmpeg / ffprobe 可执行文件路径
# 默认值已指向项目内嵌的 bin/ 套件；如需使用系统其他版本可在此覆盖
FFMPEG_PATH=bin/ffmpeg.exe
FFPROBE_PATH=bin/ffprobe.exe

# 数据目录（项目、素材、产出均存于此）
DATA_DIR=data

# 上传分片大小（字节），前端默认 5MB，这里仅作提示
# CHUNK_SIZE=5242880

# 是否允许在渲染时生成系统示例背景音乐（无版权，可替换）
# 若设置为 false，未上传音乐时视频默认静音/保留原音
GENERATE_DEMO_MUSIC=true

# 外部 AI 视觉模型接口（第二阶段启用，第一阶段为启发式分析）
# AI_VISION_API_KEY=
# AI_VISION_API_URL=
